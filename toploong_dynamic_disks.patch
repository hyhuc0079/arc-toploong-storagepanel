+
+# $1 sysfs block path, $2 normalized PCI root, $3 emitted ATA port,
+# $4 original syno_block_info. Return a slot only for the verified topology.
+_toploong_slot() {
+  _TL_RAW="$(printf '%s\n' "$4" | sed -n 's/^ata_port_no=//p')"
+  case "${_TL_RAW}" in '' | *[!0-9]*) return 1 ;; esac
+  [ "${_TL_RAW}" = "$3" ] || return 1
+  case "${2#0000:}" in
+    00:11.4)
+      [ "$3" = 3 ] || return 1
+      echo 25
+      ;;
+    00:03.2,00.0)
+      _TL_PATH="$(readlink -f "$1/device")" || return 1
+      _TL_END="$(printf '%s\n' "${_TL_PATH}" | grep -oE 'end_device-[^/]+' | tail -1)"
+      [ -n "${_TL_END}" ] || return 1
+      _TL_SAS="/sys/class/sas_device/${_TL_END}"
+      _TL_ENC="$(cat "${_TL_SAS}/enclosure_identifier" 2>/dev/null)" || return 1
+      [ "${_TL_ENC}" = "0x500605b0000272bf" ] || return 1
+      _TL_BAY="$(cat "${_TL_SAS}/bay_identifier" 2>/dev/null)" || return 1
+      case "${_TL_BAY}" in 0 | [1-9] | 1[0-9] | 2[0-3]) ;; *) return 1 ;; esac
+      echo "$((_TL_BAY + 1))"
+      ;;
+    *) return 1 ;;
+  esac
+}
+
+# Existing top-level nodes/properties must survive a live rebuild unchanged.
+# Compare decompiled trees as normalized, single-line blocks, independent of
+# node order. An unrecognized format or missing runtime DTB is a hard stop.
+_toploong_tree_records() {
+  awk '
+    /^[[:space:]]*\/dts-v1\// {next}
+    /^[[:space:]]*\/ \{/ {root=1; next}
+    root && /^[[:space:]]*};[[:space:]]*$/ && depth==0 {root=0; next}
+    root {
+      line=$0
+      gsub(/^[[:space:]]+|[[:space:]]+$/, "", line)
+      if (line=="") next
+      if (depth==0) rec=line; else rec=rec " " line
+      # dtc emits braces at the end of node-open and node-close lines.
+      if (line ~ /\{$/) depth++
+      if (line ~ /^};$/) depth--
+      if (depth==0) {print rec; n++}
+      if (depth<0) bad=1
+    }
+    END {if (root || depth || bad || n<1) exit 1}
+  ' "$1"
+}
+
+_toploong_live_add_only() (
+  _TL_TMP="$(mktemp -d /tmp/toploong-check.XXXXXX)" || exit 1
+  trap 'rm -rf "${_TL_TMP}"' EXIT
+  [ -s /run/model.dtb ] || exit 1
+  dtc -I dtb -O dts /run/model.dtb >"${_TL_TMP}/old" 2>/dev/null || exit 1
+  dtc -I dtb -O dts "$1" >"${_TL_TMP}/new" 2>/dev/null || exit 1
+  _toploong_tree_records "${_TL_TMP}/old" >"${_TL_TMP}/old.records" || exit 1
+  _toploong_tree_records "${_TL_TMP}/new" >"${_TL_TMP}/new.records" || exit 1
+  # No existing property/node may change or disappear. Only new SATA nodes
+  # may be added. This deliberately rejects live relocation and removals.
+  while IFS= read -r _TL_LINE; do
+    grep -Fxq -- "${_TL_LINE}" "${_TL_TMP}/new.records" || exit 1
+  done <"${_TL_TMP}/old.records"
+  while IFS= read -r _TL_LINE; do
+    grep -Fxq -- "${_TL_LINE}" "${_TL_TMP}/old.records" && continue
+    case "${_TL_LINE}" in internal_slot@*'protocol_type = "sata";'*) ;; *) exit 1 ;; esac
+  done <"${_TL_TMP}/new.records"
+  exit 0
+)
+
+# The normal lookup also needs to confirm the physical slot, not just port.
+_toploong_exact_slot() {
+  awk -v node="internal_slot@$2" -v pci="$3" -v port="$4" '
+    $1 ~ /^internal_slot@/ {in_slot=($1==node); matched=0}
+    in_slot && $1=="pcie_root" && $3=="\"" pci "\";" {matched=1}
+    in_slot && matched && $1=="ata_port" {
+      x=$3; sub(/^<0x0*/, "", x); sub(/>;$/, "", x)
+      if (x=="") x="0"
+      if (x==port) found=1
+    }
+    END {exit !found}
+  ' "$1"
+}
